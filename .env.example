# OpenAI API Key - get from https://platform.openai.com/api-keys
# (Not used — project uses Gemini for embeddings)
# OPENAI_API_KEY=

# Google Gemini API Key - get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Embedding model
EMBEDDING_MODEL=gemini-embedding-001

# Embedding batch size (chunks sent per API call)
EMBEDDING_BATCH_SIZE=50

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=

# Database name
MONGODB_DATABASE=mongodb_rag

# Collection name for RAG chunks
MONGODB_COLLECTION=rag_chunks

# Name of the Atlas Vector Search index you create in the UI
MONGODB_VECTOR_INDEX=vector_index

# Chunking configuration (used in Phase 4)
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Retrieval configuration
TOP_K=5

# Backend server port
PORT=3000
